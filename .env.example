# Copiá este archivo a .env.local y completá con los valores de tu proyecto.
# Panel: Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# SECRETA (server-side). Nunca la subas a git ni la expongas al browser.
SUPABASE_SERVICE_ROLE_KEY=

# AFIP SDK (factura electrónica). Homologación por defecto.
AFIP_ENV=homologacion
AFIP_ACCESS_TOKEN=
AFIP_CUIT=20409378472
AFIP_PTO_VTA=1
# Solo producción (certificado PEM autorizado para el WS de facturación):
AFIP_CERT=
AFIP_KEY=
