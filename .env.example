# Copiá este archivo a .env.local y completá con los valores de tu proyecto.
# Panel: Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# SECRETA (server-side). Nunca la subas a git ni la expongas al browser.
SUPABASE_SERVICE_ROLE_KEY=

# AFIP — conexión directa a los web services (WSAA + WSFEv1). Sin intermediario.
AFIP_ENV=homologacion            # homologacion | produccion
AFIP_CUIT=20409378472            # CUIT emisor (en producción, el real)
AFIP_PTO_VTA=1                   # punto de venta habilitado para Web Services
# Certificado (.crt) y clave privada (.key), cada uno en base64 del contenido PEM:
AFIP_CERT_B64=
AFIP_KEY_B64=
